# Never send secrets or local runtime state to Docker build context
.git
.gitignore
.env
.env.*
!.env.example
**/.env
**/.env.*
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.venv
**/venv
**/secrets/**
**/*.pem
**/*.key
**/node_modules
**/dist
**/build
