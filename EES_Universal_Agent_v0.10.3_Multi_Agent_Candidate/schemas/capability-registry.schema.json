{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Elite Engineering Suite Capability Registry",
  "type": "object",
  "required": [
    "schema_version",
    "package",
    "version",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "package": {
      "const": "elite-engineering-suite"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "source_module_count": {
      "type": "integer",
      "minimum": 0
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/capability"
      }
    }
  },
  "$defs": {
    "signal": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "required": [
            "pattern"
          ],
          "properties": {
            "pattern": {
              "type": "string",
              "minLength": 1
            },
            "weight": {
              "type": "number",
              "minimum": 0
            },
            "penalty": {
              "type": "number"
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "capability": {
      "type": "object",
      "required": [
        "id",
        "description",
        "positive_signals",
        "negative_signals",
        "activation_threshold",
        "risk_class",
        "dependencies",
        "skill_path"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "do_not_use_for": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "positive_signals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/signal"
          },
          "minItems": 1
        },
        "negative_signals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/signal"
          }
        },
        "activation_threshold": {
          "type": "number",
          "minimum": 0
        },
        "risk_class": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "must_run_with": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "must_run_before": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "must_run_after": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "conflicts_with": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "budgets": {
          "type": "object"
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_data": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "failure_escalation": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "handoff_rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "proves": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "does_not_prove": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "regression_tests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review_owner": {
          "type": "string"
        },
        "freshness_days": {
          "type": "integer",
          "minimum": 1
        },
        "skill_path": {
          "type": "string",
          "minLength": 1
        },
        "eval_spec": {
          "type": [
            "string",
            "null"
          ]
        },
        "fixtures_dir": {
          "type": [
            "string",
            "null"
          ]
        },
        "fallback_skill": {
          "type": "string"
        },
        "pre_flight_checks": {
          "type": "array"
        },
        "fixture_source": {
          "type": "string",
          "minLength": 1
        },
        "ownership": {
          "type": "object",
          "required": [
            "owner_skill",
            "primary_scope",
            "default_decision_rule",
            "handoff_skill_ids",
            "handoff_policy",
            "overlap_status",
            "conflict_policy"
          ],
          "properties": {
            "owner_skill": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "primary_scope": {
              "type": "string",
              "minLength": 1
            },
            "default_decision_rule": {
              "type": "string",
              "minLength": 1
            },
            "handoff_skill_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "handoff_policy": {
              "type": "string",
              "minLength": 1
            },
            "overlap_status": {
              "enum": [
                "candidate-review-pending",
                "reviewed-distinct",
                "merge-candidate",
                "split-candidate",
                "hard-conflict-approved",
                "not-reviewed"
              ]
            },
            "conflict_policy": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
