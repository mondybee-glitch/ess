{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["task_id", "package_version", "request", "state", "selected_skills", "dag", "budget", "actions", "criterion_results", "events", "safe_to_resume", "approval_required", "task_risk"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "package_version": {"const": "0.7.5"},
    "request": {"type": "string", "minLength": 1},
    "state": {"enum": ["PLANNED", "ROUTED", "GATED", "RUNNING", "YIELD_FOR_REROUTE", "VERIFYING", "PASSED", "FAILED", "BLOCKED", "PARTIAL", "UNVERIFIED", "RECOVERY_REQUIRED", "BUDGET_EXCEEDED"]},
    "selected_skills": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "dag": {"type": "object"},
    "budget": {"type": "object"},
    "actions": {"type": "array"},
    "criterion_results": {"type": "array", "minItems": 1},
    "events": {"type": "array"},
    "safe_to_resume": {"type": "boolean"},
    "approval_required": {"type": "boolean"},
    "task_risk": {"enum": ["low", "medium", "high", "critical"]}
  },
  "additionalProperties": true
}
