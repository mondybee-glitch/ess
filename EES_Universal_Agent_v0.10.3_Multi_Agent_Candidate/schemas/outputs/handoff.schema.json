{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skill Handoff",
  "type": "object",
  "required": [
    "task_id",
    "skill_id",
    "status",
    "artifacts",
    "evidence",
    "unverified"
  ],
  "additionalProperties": false,
  "properties": {
    "task_id": {
      "type": "string"
    },
    "skill_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "completed",
        "blocked",
        "failed",
        "needs-reroute"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "ref"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          }
        }
      }
    },
    "unverified": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_skill": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
