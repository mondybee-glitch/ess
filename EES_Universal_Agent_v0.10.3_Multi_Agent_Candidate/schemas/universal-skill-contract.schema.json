{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/elite-engineering-suite/universal-skill-contract.schema.json",
  "title": "Universal Skill Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "skill_id",
    "purpose",
    "use_when",
    "do_not_use_when",
    "inputs",
    "capabilities",
    "workflow",
    "outputs",
    "success_criteria",
    "failure_modes",
    "evidence_contract",
    "handoff_rules",
    "evaluation_cases"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "skill_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "purpose": {
      "type": "string",
      "minLength": 20
    },
    "use_when": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "do_not_use_when": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "required",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          },
          "validation": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "requiredness",
          "fallback"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "requiredness": {
            "enum": [
              "required",
              "optional",
              "conditional"
            ]
          },
          "fallback": {
            "type": "string"
          },
          "probe": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "workflow": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "step",
          "action",
          "verification"
        ],
        "properties": {
          "step": {
            "type": "integer",
            "minimum": 1
          },
          "action": {
            "type": "string",
            "minLength": 5
          },
          "verification": {
            "type": "string",
            "minLength": 5
          },
          "failure_action": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "format",
          "required"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "format": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "criterion",
          "verification_method"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "criterion": {
            "type": "string",
            "minLength": 8
          },
          "verification_method": {
            "type": "string",
            "minLength": 5
          },
          "severity": {
            "enum": [
              "blocker",
              "major",
              "minor"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "failure_modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "condition",
          "response"
        ],
        "properties": {
          "condition": {
            "type": "string"
          },
          "response": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "evidence_contract": {
      "type": "object",
      "required": [
        "required_evidence",
        "claim_policy"
      ],
      "properties": {
        "required_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "claim_policy": {
          "type": "string"
        },
        "hash_policy": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "handoff_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "evaluation_cases": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "scenario",
          "expected_behavior",
          "grading_method"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "scenario": {
            "type": "string"
          },
          "expected_behavior": {
            "type": "string"
          },
          "grading_method": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
